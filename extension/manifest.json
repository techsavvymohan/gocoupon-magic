{
  "manifest_version": 3,
  "name": "GoCoupon – Coupon Finder & Auto-Apply",
  "version": "1.1.0",
  "description": "Never overpay. Live coupons from GoCoupon database (Cuelinks + Admitad + Community). Auto-apply best coupon at checkout in 2 seconds.",
  "permissions": [
    "storage",
    "activeTab",
    "alarms",
    "tabs",
    "scripting",
    "clipboardWrite"
  ],
  "host_permissions": [
    "*://*.amazon.in/*",
    "*://*.amazon.com/*",
    "*://*.flipkart.com/*",
    "*://*.walmart.com/*",
    "*://*.bestbuy.com/*",
    "*://*.croma.com/*",
    "*://*.myntra.com/*",
    "*://*.meesho.com/*",
    "*://*.nykaa.com/*",
    "*://*.ajio.com/*",
    "https://*.supabase.co/*",
    "https://gocoupon.io/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.amazon.in/*",
        "*://*.amazon.com/*",
        "*://*.flipkart.com/*",
        "*://*.walmart.com/*",
        "*://*.bestbuy.com/*",
        "*://*.croma.com/*",
        "*://*.myntra.com/*",
        "*://*.meesho.com/*",
        "*://*.nykaa.com/*",
        "*://*.ajio.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "GoCoupon Savings Wingman",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon_16.png",
      "32": "icon_32.png",
      "48": "icon_48.png",
      "128": "icon.png"
    }
  },
  "icons": {
    "16": "icon_16.png",
    "32": "icon_32.png",
    "48": "icon_48.png",
    "128": "icon.png"
  }
}
