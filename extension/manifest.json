{
  "manifest_version": 3,
  "name": "GoCoupon – Coupon Finder",
  "version": "1.0.0",
  "description": "Never overpay. Instant Landed Cost stacking with verified coupons, bank card maximizer, and 2-second checkout auto-apply.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "*://*.amazon.in/*",
    "*://*.amazon.com/*",
    "*://*.flipkart.com/*",
    "*://*.walmart.com/*",
    "*://*.bestbuy.com/*",
    "*://*.croma.com/*",
    "https://gocoupon.io/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.amazon.in/*",
        "*://*.amazon.com/*",
        "*://*.flipkart.com/*",
        "*://*.walmart.com/*",
        "*://*.bestbuy.com/*",
        "*://*.croma.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "GoCoupon Savings Wingman"
  },
  "icons": {
    "128": "icon.png"
  }
}
