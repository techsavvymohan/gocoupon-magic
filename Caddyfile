# GoCoupon Production Caddy Configuration — Auto SSL via Let's Encrypt
# Managed on Bluehost Ubuntu 24.04 VPS (50.6.37.40)

gocoupon.io, www.gocoupon.io {
	encode gzip zstd

	reverse_proxy 127.0.0.1:3000

	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		-Server
	}
}

http://50.6.37.40 {
	encode gzip zstd
	reverse_proxy 127.0.0.1:3000
}
